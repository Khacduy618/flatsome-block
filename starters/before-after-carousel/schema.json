{
  "type": "container",
  "allow": ["fbm_before_after"],
  "info": "{{ per_view }} / khung",
  "presets": [
    {
      "name": "2 slider",
      "content": "[fbm_ba_carousel][fbm_before_after][fbm_before_after][/fbm_ba_carousel]"
    }
  ],
  "builder_template": "<div class=\"fbm-bac {{ shortcode.options.class }}\" style=\"--fbm-per: {{ shortcode.options.perView }}; --fbm-gap: {{ shortcode.options.gap }}px\"><div class=\"fbm-bac__track\"><content></content></div></div>",
  "options": {
    "per_view": { "type": "slider", "heading": "Số slider mỗi khung", "default": "1", "min": 1, "max": 4 },
    "gap": { "type": "slider", "heading": "Khoảng cách", "default": "16", "min": 0, "max": 60, "unit": "px" },
    "arrows": { "type": "checkbox", "heading": "Nút trước / sau", "default": "true" },
    "advanced_options": "@commons/advanced"
  }
}
