    "align": {
      "type": "radio-buttons",
      "heading": "Căn lề",
      "default": "center",
      "options": { "left": { "title": "Trái" }, "center": { "title": "Giữa" }, "right": { "title": "Phải" } }
    },
    "text": { "type": "textarea", "heading": "Nội dung", "default": "", "full_width": true },
    "advanced_options": "@commons/advanced"
  }
}
