{
  "info": "{{ label_before }} / {{ label_after }}",
  "options": {
    "images": {
      "type": "group",
      "heading": "Ảnh",
      "options": {
        "before": { "type": "image", "heading": "Ảnh trước", "default": "" },
        "after": { "type": "image", "heading": "Ảnh sau", "default": "" },
        "image_size": {
          "type": "select",
          "heading": "Kích thước ảnh",
          "default": "large",
          "options": { "medium": "Medium", "medium_large": "Medium Large", "large": "Large", "full": "Ảnh gốc" }
        }
      }
    },
    "behaviour": {
      "type": "group",
      "heading": "Cách trượt",
      "options": {
        "orientation": {
          "type": "radio-buttons",
          "heading": "Hướng",
          "default": "horizontal",
          "options": { "horizontal": { "title": "Ngang" }, "vertical": { "title": "Dọc" } }
        },
        "trigger": {
          "type": "radio-buttons",
          "heading": "Điều khiển",
          "default": "drag",
          "options": { "drag": { "title": "Kéo" }, "hover": { "title": "Rê chuột" } }
        },
        "offset": { "type": "slider", "heading": "Vị trí bắt đầu", "default": "50", "min": 0, "max": 100, "unit": "%" },
        "auto": { "type": "checkbox", "heading": "Tự trượt khi cuộn tới", "default": "false" }
      }
    },
    "labels": {
      "type": "group",
      "heading": "Nhãn, caption, badge",
      "options": {
        "show_labels": { "type": "checkbox", "heading": "Hiện nhãn", "default": "true" },
        "label_before": { "type": "textfield", "heading": "Nhãn trước", "default": "Trước" },
        "label_after": { "type": "textfield", "heading": "Nhãn sau", "default": "Sau" },
        "label_color": { "type": "colorpicker", "heading": "Màu chữ nhãn", "default": "#ffffff" },
        "label_bg": { "type": "colorpicker", "heading": "Nền nhãn", "default": "rgba(0,0,0,0.55)", "alpha": true },
        "caption": { "type": "textfield", "heading": "Caption", "default": "" },
        "badge": { "type": "textfield", "heading": "Badge", "default": "" }
      }
    },
    "divider": {
      "type": "group",
      "heading": "Đường chia & tay nắm",
      "options": {
        "line_color": { "type": "colorpicker", "heading": "Màu đường chia", "default": "#ffffff" },
        "line_width": { "type": "slider", "heading": "Độ dày", "default": "2", "min": 1, "max": 8, "unit": "px" },
        "handle": {
          "type": "select",
          "heading": "Tay nắm",
          "default": "circle",
          "options": { "circle": "Tròn", "square": "Vuông", "none": "Ẩn tay nắm" }
        },
        "overlay": { "type": "checkbox", "heading": "Phủ tối khi rê chuột", "default": "false" }
      }
    },
    "advanced_options": "@commons/advanced"
  }
}
