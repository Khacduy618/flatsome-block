{
  "info": "{{ title }}",
  "options": {
    "query": {
      "type": "group",
      "heading": "Nguồn sản phẩm",
      "options": {
        "source": {
          "type": "select",
          "heading": "Lấy sản phẩm",
          "default": "recent",
          "options": {
            "recent": "Mới nhất",
            "featured": "Nổi bật",
            "sale": "Đang giảm giá",
            "best_selling": "Bán chạy",
            "top_rated": "Đánh giá cao",
            "ids": "Chọn từng sản phẩm"
          }
        },
        "ids": {
          "type": "select",
          "heading": "Sản phẩm",
          "description": "Gutenberg: nhập ID, cách nhau dấu phẩy.",
          "default": "",
          "full_width": true,
          "conditions": "source == \"ids\"",
          "config": { "multiple": true, "placeholder": "Chọn sản phẩm...", "postSelect": { "post_type": ["product"] } }
        },
        "limit": { "type": "slider", "heading": "Số sản phẩm tối đa", "default": "12", "min": 1, "max": 48, "step": 1 },
        "offset": { "type": "slider", "heading": "Bỏ qua N sản phẩm đầu", "default": "0", "min": 0, "max": 50, "step": 1 },
        "orderby": {
          "type": "select",
          "heading": "Sắp xếp theo",
          "description": "Không áp dụng cho nguồn Bán chạy, Đánh giá cao, Chọn từng sản phẩm.",
          "default": "date",
          "options": {
            "date": "Ngày đăng",
            "price": "Giá",
            "popularity": "Lượt bán",
            "rating": "Điểm đánh giá",
            "title": "Tên",
            "menu_order": "Thứ tự tuỳ chỉnh",
            "rand": "Ngẫu nhiên"
          }
        },
        "order": {
          "type": "radio-buttons",
          "heading": "Chiều sắp xếp",
          "default": "DESC",
          "options": { "DESC": { "title": "Giảm dần" }, "ASC": { "title": "Tăng dần" } }
        }
      }
    },
    "filters": {
      "type": "group",
      "heading": "Bộ lọc",
      "options": {
        "cat": {
          "type": "select",
          "heading": "Danh mục",
          "description": "Gutenberg: nhập ID hoặc slug, cách nhau dấu phẩy.",
          "default": "",
          "full_width": true,
          "config": { "multiple": true, "placeholder": "Tất cả danh mục", "termSelect": { "post_type": "product_cat", "taxonomies": "product_cat" } }
        },
        "tags": {
          "type": "select",
          "heading": "Tag",
          "description": "Gutenberg: nhập ID hoặc slug, cách nhau dấu phẩy.",
          "default": "",
          "full_width": true,
          "config": { "multiple": true, "placeholder": "Tất cả tag", "termSelect": { "post_type": "product", "taxonomies": "product_tag" } }
        },
        "exclude": { "type": "textfield", "heading": "Loại trừ ID sản phẩm", "placeholder": "12, 34", "default": "" },
        "price_min": { "type": "textfield", "heading": "Giá từ", "placeholder": "0", "default": "" },
        "price_max": { "type": "textfield", "heading": "Giá đến", "placeholder": "Không giới hạn", "default": "" },
        "in_stock": { "type": "checkbox", "heading": "Chỉ hiện hàng còn", "default": "false" }
      }
    },
    "slider": {
      "type": "group",
      "heading": "Slider",
      "options": {
        "per_view": { "type": "slider", "heading": "Số cột desktop", "default": "4", "min": 1, "max": 6, "step": 1 },
        "per_view_md": { "type": "slider", "heading": "Số cột tablet", "default": "3", "min": 1, "max": 4, "step": 1 },
        "per_view_sm": { "type": "slider", "heading": "Số cột mobile", "default": "2", "min": 1, "max": 3, "step": 1 },
        "gap": { "type": "slider", "heading": "Khoảng cách", "default": "20", "min": 0, "max": 48, "step": 2, "unit": "px" },
        "slide_by": {
          "type": "radio-buttons",
          "heading": "Mỗi lần trượt",
          "default": "1",
          "options": { "1": { "title": "1 sản phẩm" }, "page": { "title": "1 trang" } }
        },
        "arrows": { "type": "checkbox", "heading": "Nút trước / sau", "default": "true" },
        "dots": { "type": "checkbox", "heading": "Chấm phân trang", "default": "true" },
        "loop": { "type": "checkbox", "heading": "Vòng lặp", "default": "true" },
        "autoplay": { "type": "checkbox", "heading": "Tự chạy", "default": "false" },
        "autoplay_ms": {
          "type": "slider",
          "heading": "Thời gian mỗi lượt",
          "default": "4000",
          "min": 2000,
          "max": 10000,
          "step": 500,
          "unit": "ms",
          "conditions": "autoplay === \"true\""
        }
      }
    },
    "card": {
      "type": "group",
      "heading": "Thẻ sản phẩm",
      "options": {
        "card_style": {
          "type": "radio-buttons",
          "heading": "Kiểu thẻ",
          "default": "border",
          "options": { "plain": { "title": "Phẳng" }, "border": { "title": "Viền" }, "shadow": { "title": "Bóng" } }
        },
        "image_ratio": {
          "type": "select",
          "heading": "Tỉ lệ ảnh",
          "default": "1/1",
          "options": { "1/1": "Vuông 1:1", "4/5": "Dọc 4:5", "3/4": "Dọc 3:4", "4/3": "Ngang 4:3", "auto": "Theo ảnh gốc" }
        },
        "image_size": {
          "type": "select",
          "heading": "Kích thước ảnh",
          "default": "woocommerce_thumbnail",
          "options": { "woocommerce_thumbnail": "Shop thumbnail", "medium": "Medium", "large": "Large" }
        },
        "hover_image": { "type": "checkbox", "heading": "Đổi sang ảnh thứ 2 khi rê chuột", "default": "true" },
        "show_badge": { "type": "checkbox", "heading": "Nhãn giảm giá / hết hàng", "default": "true" },
        "show_cat": { "type": "checkbox", "heading": "Danh mục", "default": "true" },
        "show_rating": { "type": "checkbox", "heading": "Sao đánh giá", "default": "true" },
        "show_price": { "type": "checkbox", "heading": "Giá", "default": "true" },
        "show_button": { "type": "checkbox", "heading": "Nút thêm vào giỏ", "default": "true" },
        "button_text": {
          "type": "textfield",
          "heading": "Chữ trên nút",
          "description": "Chỉ áp dụng cho sản phẩm thêm vào giỏ được ngay. Bỏ trống để dùng chữ của WooCommerce.",
          "default": "",
          "conditions": "show_button === \"true\""
        },
        "title_lines": { "type": "slider", "heading": "Số dòng tên sản phẩm", "default": "2", "min": 1, "max": 3, "step": 1 },
        "text_align": {
          "type": "radio-buttons",
          "heading": "Căn chữ",
          "default": "left",
          "options": { "left": { "title": "Trái" }, "center": { "title": "Giữa" } }
        },
        "radius": { "type": "slider", "heading": "Bo góc", "default": "8", "min": 0, "max": 24, "step": 1, "unit": "px" },
        "accent": { "type": "colorpicker", "heading": "Màu nhấn", "description": "Bỏ trống để dùng màu chính của Flatsome.", "default": "" }
      }
    },
    "heading_group": {
      "type": "group",
      "heading": "Tiêu đề",
      "options": {
        "title": { "type": "textfield", "heading": "Tiêu đề", "default": "" },
        "link_text": { "type": "textfield", "heading": "Chữ liên kết", "default": "" },
        "link_url": { "type": "textfield", "heading": "Đường dẫn", "placeholder": "/shop/", "default": "" },
        "empty_text": { "type": "textfield", "heading": "Khi không có sản phẩm", "default": "Không có sản phẩm phù hợp." }
      }
    },
    "advanced_options": "@commons/advanced"
  }
}
