{
  "name": "flatsome-block-manager",
  "version": "1.0.0",
  "private": true,
  "description": "Admin UI + Gutenberg editor script cho Flatsome Block Manager",
  "scripts": {
    "build": "wp-scripts build admin=./assets/src/admin/index.js gutenberg=./assets/src/gutenberg/index.js --output-path=build",
    "start": "wp-scripts start admin=./assets/src/admin/index.js gutenberg=./assets/src/gutenberg/index.js --output-path=build",
    "zip": "npm run build && sh ./bin/zip.sh"
  },
  "devDependencies": {
    "@wordpress/scripts": "^30.0.0"
  }
}
